# Public-by-design values (safe to ship in the client; access is gated by RLS / Google).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: Gemini, Google Places, and Pexels keys are NO LONGER client-side. They are held
# as Supabase Edge Function secrets and reached via the `ext-proxy` function. Do NOT add
# EXPO_PUBLIC_GEMINI_API_KEY / EXPO_PUBLIC_GOOGLE_PLACES_API_KEY / EXPO_PUBLIC_PEXELS_API_KEY
# here — anything EXPO_PUBLIC_* ships in the app bundle and is extractable.
# Set them instead with:
#   supabase secrets set GEMINI_API_KEY=... GOOGLE_PLACES_API_KEY=... PEXELS_API_KEY=...

# Google OAuth — created in Google Cloud Console → OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
