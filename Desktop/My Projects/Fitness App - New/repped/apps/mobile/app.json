{
  "expo": {
    "name": "Livvia",
    "slug": "livvia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "livvia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.livvia.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Livvia uses your location to find nearby restaurants and grocery stores for your meal plan.",
        "NSCameraUsageDescription": "Livvia uses your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Livvia accesses your photos to set a profile picture.",
        "LSApplicationQueriesSchemes": [
          "youtube",
          "vnd.youtube",
          "ubereats",
          "doordash",
          "comgooglemaps",
          "maps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.livvia.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      ["expo-router", { "root": "./app" }]
    ]
  }
}
