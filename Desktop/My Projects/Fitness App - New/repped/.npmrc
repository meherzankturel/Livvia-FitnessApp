# Reanimated 4.1.x declares an open-ended peer (react-native-worklets >=0.5.0), so npm
# auto-installs the latest worklets (0.8.x) at the workspace root — but Reanimated's
# native podspec only accepts 0.5.x–0.7.x, which breaks `pod install` on EAS.
# Disabling peer auto-install (plus the react-native-worklets override in package.json)
# pins worklets to the SDK-54-correct 0.5.1 everywhere. EAS Build respects this file too.
legacy-peer-deps=true
